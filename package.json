{
  "name": "musescore-collab",
  "version": "2.0.0",
  "description": "Git-style collaborative version control and live sessions for MuseScore",
  "bin": "./install.js",
  "scripts": {
    "install-plugin": "node install.js",
    "postinstall": "node install.js",
